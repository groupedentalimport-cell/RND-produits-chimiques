# ============================================================
# ChemStab — Environment Variables Example
# ============================================================
# Copy this file to `.env` and fill in the values for your
# local development environment.
#
#   cp .env.example .env
#
# NEVER commit your real `.env` file to version control.
# ============================================================

# ── Database ────────────────────────────────────────────────────
#
# Prisma connection string.
#
# For local development with SQLite (default):
#   DATABASE_URL="file:./db/custom.db"
#
# For production with PostgreSQL:
#   DATABASE_URL="postgresql://user:password@localhost:5432/chemstab?schema=public"
#
DATABASE_URL="file:./db/custom.db"

# ── PostgreSQL Container (docker-compose) ──────────────────────
POSTGRES_USER=chemstab
POSTGRES_PASSWORD=changeme
POSTGRES_DB=chemstab
DB_PORT=5432

# ── Application Environment ─────────────────────────────────────
#
# Controls Next.js runtime behaviour and optimisations.
#   "development"  — hot reload, verbose errors, dev tools
#   "production"   — optimised builds, minified output, error pages
#   "test"         — used by test runners
#
NODE_ENV="development"

# ── NextAuth.js ─────────────────────────────────────────────────
#
# The canonical URL of your application.
# NextAuth uses this to generate correct callback URLs and redirects.
#   Local:   http://localhost:3000
#   Deploy:  https://chemstab.yourdomain.com
#
NEXTAUTH_URL="http://localhost:3000"

# Secret used to encrypt session tokens and sign cookies.
# Generate a strong random string, e.g.:
#   openssl rand -base64 32
#   or:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
NEXTAUTH_SECRET=""
