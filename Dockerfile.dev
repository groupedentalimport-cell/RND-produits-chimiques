# ============================================================
# ChemStab — Development Dockerfile (Next.js + bun hot reload)
# ============================================================
#
# Runs `bun run dev` for live development with hot module reload.
# Does NOT build the production standalone output.
#
# Port: 3000
# ============================================================

FROM oven/bun:1

WORKDIR /app

# Development environment
ENV NODE_ENV=development

# Copy dependency manifests first for cache-efficient installs
COPY package.json bun.lock ./

# Copy Prisma schema so we can generate the client
COPY prisma ./prisma/

# Install all dependencies (including devDependencies)
RUN bun install --frozen-lockfile

# Generate Prisma client
RUN bun run db:generate

# Copy the rest of the application source
COPY . .

# Copy .env so DATABASE_URL is available
COPY .env .env

# Expose the application port
EXPOSE 3000

# Healthcheck — verify the Next.js dev server is responding
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD curl -f http://localhost:3000/ || exit 1

# Start the Next.js dev server with hot reload
CMD ["bun", "--hot", "run", "dev"]
