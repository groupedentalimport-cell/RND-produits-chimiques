# ============================================================
# ChemStab Notifications Service — Dev Dockerfile (bun hot reload)
# ============================================================
#
# Development mode with hot reload via bun --hot.
#
# Port: 3003
# ============================================================

FROM oven/bun:1

WORKDIR /app

# Development environment
ENV NODE_ENV=development

# Copy dependency manifests and install
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Copy the service entry point
COPY index.ts ./

# Expose the notifications service port
EXPOSE 3003

# Healthcheck — verify socket.io engine.io polling handshake responds
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD curl -f "http://localhost:3003/?EIO=4&transport=polling" || exit 1

# Start the notifications service with hot reload
CMD ["bun", "--hot", "index.ts"]
